generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model checklist {
  id_checklist Int        @id @default(autoincrement())
  titulo       String     @db.VarChar(150)
  ativo        Boolean?   @default(true)
  data_criacao DateTime?  @default(now()) @db.Timestamptz(6)
  execucao     execucao[]
  item         item[]
}

model execucao {
  id_execucao    Int        @id @default(autoincrement())
  id_checklist   Int
  id_usuario     Int
  status         String?    @default("EM_ANDAMENTO") @db.VarChar(50)
  data_inicio    DateTime?  @default(now()) @db.Timestamptz(6)
  data_conclusao DateTime?  @db.Timestamptz(6)
  checklist      checklist  @relation(fields: [id_checklist], references: [id_checklist], onUpdate: NoAction, map: "fk_execucao_checklist")
  usuario        usuario    @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction, map: "fk_execucao_usuario")
  resposta       resposta[]
}

model item {
  id_item      Int        @id @default(autoincrement())
  id_checklist Int
  ordem        Int
  descricao    String
  tipo         String     @db.VarChar(50)
  obrigatorio  Boolean?   @default(true)
  checklist    checklist  @relation(fields: [id_checklist], references: [id_checklist], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_checklist")
  resposta     resposta[]
}

model resposta {
  id_resposta    Int      @id @default(autoincrement())
  id_execucao    Int
  id_item        Int
  valor_resposta String?
  observacao     String?
  execucao       execucao @relation(fields: [id_execucao], references: [id_execucao], onDelete: Cascade, onUpdate: NoAction, map: "fk_resposta_execucao")
  item           item     @relation(fields: [id_item], references: [id_item], onUpdate: NoAction, map: "fk_resposta_item")

  @@unique([id_execucao, id_item], map: "uk_execucao_item")
}

model usuario {
  id_usuario    Int        @id @default(autoincrement())
  nome          String     @db.VarChar(100)
  email         String     @unique @db.VarChar(150)
  data_cadastro DateTime?  @default(now()) @db.Timestamptz(6)
  senha         String     @db.VarChar(255)
  setor         String?    @db.VarChar(100)
  execucao      execucao[]
}
